# ============================================================
# Konfigurasi Bot WhatsApp Prediksi Saham IDX
# Salin file ini menjadi `.env` lalu isi sesuai akun kamu.
# JANGAN commit `.env` ke git (sudah di .gitignore).
# ============================================================

# Base URL API chatetin
CHATETIN_BASE_URL=https://wa.chatetin.com

# Kredensial login wa.chatetin.com
CHATETIN_USERNAME=dirman@yrpk.or.id
CHATETIN_PASSWORD=12345678

# Nomor WhatsApp yang BOLEH memerintah bot (pisah koma utk lebih dari satu).
# Bot TIDAK akan merespon nomor lain. Format: 62xxxxxxxxxx (tanpa +, tanpa @).
# Contoh 4 nomor:
#   ALLOWED_NUMBERS=6285720300059,6281234567890,6289876543210,6285555555555
ALLOWED_NUMBERS=6285720300059

# Interval polling pesan masuk (detik)
POLL_INTERVAL=3
