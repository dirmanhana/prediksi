# ============================================================
# Konfigurasi Bot WhatsApp Prediksi Saham IDX
# Salin file ini menjadi `.env` lalu isi sesuai akun kamu.
# JANGAN commit `.env` ke git (sudah di .gitignore).
# ============================================================

# Base URL API chatetin
CHATETIN_BASE_URL=https://wa.chatetin.com

# Kredensial login wa.chatetin.com
# ⚠️ Isi password ASLI hanya di file .env (tidak di-commit).
# Jangan taruh password asli di .env.example — file ini ikut ter-commit ke git.
CHATETIN_USERNAME=dirman@yrpk.or.id
CHATETIN_PASSWORD=ganti_password_anda

# Nomor WhatsApp yang BOLEH memerintah bot (pisah koma utk lebih dari satu).
# Bot TIDAK akan merespon nomor lain. Format: 62xxxxxxxxxx (tanpa +, tanpa @).
# Contoh 4 nomor:
#   ALLOWED_NUMBERS=6280000000,6280000000,6289999999,6285555555555
ALLOWED_NUMBERS=62xxxxxxxxxx

# Interval polling pesan masuk (detik)
POLL_INTERVAL=3

# Ambang likuiditas saham yang boleh direkomendasikan bot
# MIN_VALUE_TRADED = nilai transaksi minimal per hari (Rp). Default 1 miliar.
# MIN_PRICE = harga minimal (Rp). Default 200 (hindari penny stock ekstrem).
MIN_VALUE_TRADED=1000000000
MIN_PRICE=200

# Jam push otomatis laporan watchlist (format HH:MM, zona WIB). Kosongkan utk nonaktif.
WATCH_REPORT_TIME=18:00

# Jam push otomatis REKAP PASAR ke semua user (format HH:MM, zona WIB). Kosongkan utk nonaktif.
# Contoh: RECAP_PUSH_TIME=18:05
RECAP_PUSH_TIME=

# ============================================================
# MODE PESAN MASUK (pilih salah satu)
# 1) POLLING (default, cocok 1-10 user): biarkan WEBHOOK_URL kosong
# 2) WEBHOOK (skala besar, hemat API): isi WEBHOOK_URL dengan alamat
#    publik server (mis. https://bot.domain.com) lalu buka port WEBHOOK_PORT.
#    Bot akan daftarkan webhook ke chatetin & mematikan polling.
# ============================================================
WEBHOOK_URL=
WEBHOOK_PORT=8080
WEBHOOK_SECRET=

# ============================================================
# ADMIN WHITELIST: nomor yang boleh kelola daftar user
# (tambah/hapus user langsung dari chat, tanpa edit file/restart)
# Format: 62xxxxxxxxxx, pisah koma
# ============================================================
BOT_ADMINS=6285720300059,6285780535433

# ============================================================
# MONEV (monitoring & evaluasi prediksi vs aktual)
# Setelah jam ini (WIB), bot otomatis:
#   1) capture penutupan SESI 1 & 2 saham yang diprediksi (Yahoo 15m)
#   2) bangun laporan monev (data/eval/)
#   3) commit + push data/eval/ ke origin (aktifkan lewat MONEV_AUTO_PUSH=1)
# PENTING: set jam SETELAH cron predict_daily.py (17:30 WIB) selesai, supaya
# close harian hari itu sudah ada -> evaluasi status_model bisa lengkap.
# Kosongkan MONEV_TIME utk menonaktifkan monev harian otomatis.
# ============================================================
MONEV_TIME=18:30
MONEV_AUTO_PUSH=1
# Jendela capture sesi (hari ke belakang). Yahoo hanya menyediakan 15m ~60 hari,
# jadi jangan lebih dari 59.
MONEV_DAYS=55

# ============================================================
# AI CHAT (opsional) — user bisa `chat on` lalu tanya-jawab dengan AI
# soal semua data (prediksi, sesi 1/2, monev, rekap).
# Kosongkan AGNES_API_KEY utk menonaktifkan fitur ini.
# ============================================================
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
# Model utama & cadangan (fallback otomatis kalau kena rate limit/error).
# Hasil uji: agnes-3.0-flash = paling cepat (~54 token/detik) & andal.
# agnes-2.0-flash sering kena rate-limit free tier -> jangan dipakai.
AGNES_MODEL=agnes-3.0-flash
AGNES_MODEL_FALLBACK=agnes-2.5-flash
# Aturan jendela chat (menit): sliding per pesan, dibatasi total sejak aktivasi.
AI_CHAT_WINDOW=5
AI_CHAT_MAX=30
# Batas pesan AI per user per hari (hemat kuota & cegah penyalahgunaan).
AI_CHAT_MAX_MSG_DAY=40
